{
  "name": "svelte-urql-runes",
  "version": "0.1.0",
  "description": "Runes-native urql bindings for Svelte 5: reactive queries, mutations and subscriptions, plus SSR-friendly SvelteKit clients",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "svelte",
    "sveltekit",
    "urql",
    "graphql",
    "runes",
    "svelte5",
    "gql.tada",
    "ssr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmytroKondrashov/svelte-urql-runes.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "default": "./dist/kit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llms.txt",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "svelte-package -i src/lib -o dist && publint",
    "build:demo": "vite build",
    "prepublishOnly": "npm run build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@urql/core": "^6.0.0",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "esm-env": "^1.2.2",
    "wonka": "^6.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@urql/core": "^6.0.3",
    "@vitest/browser-playwright": "^5.1.0",
    "gql.tada": "^1.11.4",
    "graphql": "^17.1.0",
    "playwright": "^1.65.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vitest-browser-svelte": "^3.1.0"
  }
}
